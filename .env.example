# Meeting BaaS API Configuration
MEETING_BAAS=your_meeting_baas_api_key_here
MEETING_BAAS_WEBHOOK=your_webhook_secret_here
# Optional: Static public URL / Cloudflare tunnel / Static Ngrok domain (leave blank for automatic live ngrok discovery)
WEBHOOK_URL=

# LiteLLM & Groq AI Agent Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=groq/qwen/qwen3.8-27b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=150

# Agent Persona Settings
DEFAULT_BOT_NAME=akshat-agent
DEFAULT_ENTRY_MESSAGE="Hey everyone, akshat-agent here. Glad to join."
DEFAULT_BOT_PROMPT="You are akshat-agent, a friendly software engineer participating in a Google Meet. You listen carefully and only speak when someone asks you a question or directly addresses you. Keep answers very concise, punchy, conversational, and direct (1-2 sentences). Do not introduce yourself repeatedly. Do not interrupt other participants."
DEFAULT_RECORDING_MODE=speaker_view
LOG_LEVEL=INFO

# Speech engines (STT + TTS). USE_GROQ=true -> Groq Whisper + Groq Orpheus.
# Otherwise -> Deepgram Nova-3 + Deepgram Flux (streamed). No fallback between them.
USE_GROQ=false
# Deepgram: free $200 credit at https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# DEEPGRAM_TTS_MODEL=flux-sienna-en
# DEEPGRAM_STT_MODEL=nova-3

# Other AI agents expected in the call (comma-separated display names)
# OTHER_AI_PARTICIPANTS=Memorae,Boardy
# Extra spellings of the bot name the transcriber may produce (comma-separated)
# BOT_NAME_ALIASES=

# In-meeting memory notes (background, small Groq model with its own rate limit)
# MEMORY_NOTES_ENABLED=true
# MEMORY_NOTES_MODEL=openai/gpt-oss-20b
